<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BÚHO Barber Studio</title>
    
    <!-- Estilos CSS Base -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Hoja de estilos específica para las clases del portal público -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }
    body { background-color: #0b0f19; color: #f3f4f6; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }
    
    /* Efecto de destello/reflejo unificado con el admin */
    .btn-reflejo {
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .btn-reflejo::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(
            to right,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        transform: rotate(30deg) translateX(-100%);
        transition: transform 0.6s ease-in-out;
    }
    .btn-reflejo:hover::after {
        transform: rotate(30deg) translateX(100%);
    }

    /* Efecto Hover y Active con degradado (Azul a Rosado) */
    .nav-link {
        transition: all 0.3s ease;
    }
    
    .nav-link:hover, .nav-link.active {
        background: linear-gradient(to right, #60a5fa, #ec4899);
        background-clip: text;          
        -webkit-background-clip: text;  
        -webkit-text-fill-color: transparent;
        font-weight: 600;
    }

    .nav-link.active {
        border-bottom: 2px solid #ec4899;
        padding-bottom: 2px;
    }
</style>

</head>
<body class="antialiased selection:bg-pink-500 selection:text-white">

    <!-- MENÚ DE NAVEGACIÓN -->
    <header class="w-full bg-[#0D111A]/90 backdrop-blur-xl border-b border-[#1E2638] sticky top-0 z-50 px-6 sm:px-10 py-6 flex items-center justify-between shadow-lg">
        <a href="/" class="flex items-center gap-3 group text-decoration-none">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center overflow-hidden group-hover:scale-105 transition-transform p-1.5">
                <img src="/img/buho.png" alt="Logo Búho" class="w-full h-full object-contain">
            </div>
            <div>
                <span class="text-lg sm:text-xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-pink-500 tracking-wider">BÚHO</span>
                <span class="block text-[10px] sm:text-xs uppercase tracking-widest text-slate-400 font-semibold">Barber Studio</span>
            </div>
        </a>

        <!-- Enlaces de navegación Desktop -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="/" class="nav-link text-base font-medium text-slate-400" data-path="/">Inicio</a>
            <a href="/#tendencias" class="nav-link text-base font-medium text-slate-400" data-path="/#tendencias">Tendencias</a>
            <a href="/#servicios" class="nav-link text-base font-medium text-slate-400" data-path="/#servicios">Servicios</a>
            <a href="/#barberos" class="nav-link text-base font-medium text-slate-400" data-path="/#barberos">Staff</a>
            <a href="/#indumentaria" class="nav-link text-base font-medium text-slate-400" data-path="/#indumentaria">Indumentaria</a>
            <a href="/#quienes-somos" class="nav-link text-base font-medium text-slate-400" data-path="/#quienes-somos">¿Quiénes Somos?</a>
        </nav>

        <!-- Botones de Acción y Hamburguesa Mobile -->
        <div class="flex items-center gap-3">
            <a href="/reservar" class="btn-reflejo hidden sm:flex px-5 py-3 bg-gradient-to-r from-blue-600 to-pink-600 hover:from-blue-500 hover:to-pink-500 text-white text-sm sm:text-base font-semibold rounded-xl shadow-[0_4px_15px_rgba(236,72,153,0.3)] transition-all items-center gap-2.5 text-decoration-none">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Reservar Turno</span>
            </a>

            <!-- Botón Menú Hamburguesa -->
            <button id="menuBtn" class="md:hidden w-11 h-11 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white flex items-center justify-center text-lg focus:outline-none transition-all cursor-pointer">
                <i class="fa-solid fa-bars" id="menuIcon"></i>
            </button>
        </div>
    </header>

    <!-- MENÚ DESPLEGABLE MOBILE -->
    <div id="mobileMenu" class="hidden md:hidden fixed top-[89px] left-0 w-full bg-[#0D111A]/98 backdrop-blur-2xl border-b border-[#1E2638] px-6 py-6 flex flex-col gap-4 shadow-2xl z-40 transition-all">
        <a href="/" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">Inicio</a>
        <a href="/#tendencias" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">Tendencias</a>
        <a href="/#servicios" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">Servicios</a>
        <a href="/#barberos" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">Staff</a>
        <a href="/#indumentaria" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">Indumentaria</a>
        <a href="/#quienes-somos" class="mobile-link text-slate-300 font-medium text-base hover:text-blue-400 py-2 border-b border-slate-800/60">¿Quiénes Somos?</a>
        
        <a href="/reservar" class="btn-reflejo w-full mt-2 py-3.5 bg-gradient-to-r from-blue-600 to-pink-600 text-white font-bold rounded-xl shadow-lg flex items-center justify-center gap-2 text-center text-decoration-none">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Reservar Turno</span>
        </a>
    </div>

    <!-- CONTENIDO DINÁMICO -->
    <main class="flex-grow w-full">
        <%- body %>
    </main>

    <!-- FOOTER UNIFICADO -->
    <footer class="w-full bg-slate-900/80 backdrop-blur-xl border-t border-white/5 py-10 px-6 mt-auto flex flex-col items-center justify-center text-center gap-5">
        <div class="text-lg font-extrabold text-white tracking-wider">
            BÚHO <span class="text-pink-500">STUDIO</span>
        </div>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
            El punto de encuentro entre la estética moderna y el cuidado masculino profesional.
        </p>
        <div class="flex items-center gap-4 text-lg">
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-all shadow-md">
                <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-all shadow-md">
                <i class="fa-brands fa-tiktok"></i>
            </a>
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-all shadow-md">
                <i class="fa-brands fa-whatsapp"></i>
            </a>
        </div>
        <div class="border-t border-white/5 pt-4 w-full max-w-xs text-xs text-slate-500 font-medium">
            &copy; 2026 BÚHO Barber Studio. Todos los derechos reservados.
        </div>
    </footer>

    <!-- SCRIPTS PARA GESTIONAR EL ESTADO ACTIVO Y EL MENÚ MÓVIL -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Gestión del menú hamburguesa
            const menuBtn = document.getElementById('menuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            const menuIcon = document.getElementById('menuIcon');

            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
                if (mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                } else {
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-xmark');
                }
            });

            // Cerrar menú móvil al hacer clic en cualquier enlace
            document.querySelectorAll('.mobile-link').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                });
            });

            // Gestión de enlaces activos de navegación
            const navLinks = document.querySelectorAll(".nav-link");
            const currentFullPath = window.location.pathname + window.location.hash;

            navLinks.forEach(link => {
                const linkPath = link.getAttribute("href");
                if (currentFullPath === linkPath || (window.location.hash === "" && linkPath === "/")) {
                    link.classList.add("active");
                }

                link.addEventListener("click", function() {
                    navLinks.forEach(nav => nav.classList.remove("active"));
                    this.classList.add("active");
                });
            });
        });
    </script>
</body>
</html>