<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Panel de Administración | Búho' %></title>
    <!-- Estilos CSS y Tailwind -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { font-family: 'Outfit', sans-serif; }
        
        /* Efecto de destello/reflejo para los botones de acción */
        .btn-reflejo {
          position: relative;
          overflow: hidden;
          transition: all 0.3s ease;
        }
        .btn-reflejo::after {
          content: '';
          position: absolute;
          top: -50%;
          left: -50%;
          width: 200%;
          height: 200%;
          background: linear-gradient(
            to right,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0) 100%
          );
          transform: rotate(30deg) translateX(-100%);
          transition: transform 0.6s ease-in-out;
        }
        .btn-reflejo:hover::after {
          transform: rotate(30deg) translateX(100%);
        }

        /* Scrollbar personalizada y discreta para el sidebar */
        aside nav::-webkit-scrollbar { width: 4px; }
        aside nav::-webkit-scrollbar-track { background: transparent; }
        aside nav::-webkit-scrollbar-thumb { background: #1E2638; border-radius: 4px; }
    </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 flex h-screen overflow-hidden m-0 p-0">

    <!-- 1. BARRA VERTICAL IZQUIERDA (SIDEBAR MODERNIZADA) -->
    <aside class="w-72 bg-[#0D111A]/95 backdrop-blur-xl border-r border-[#1E2638] flex flex-col z-50 shrink-0 hidden md:flex shadow-2xl">
        <!-- Logo y Título de Marca -->
        <div class="p-6 border-b border-[#1E2638] flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500/20 to-indigo-500/20 border border-blue-500/40 flex items-center justify-center overflow-hidden p-1.5 shadow-[0_0_15px_rgba(59,130,246,0.15)]">
                <img src="/img/buho.png" alt="Logo Búho" class="w-full h-full object-contain">
            </div>
            <div>
                <span class="text-lg font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-pink-500 tracking-wider">BÚHO</span>
                <span class="block text-[10px] uppercase tracking-widest text-slate-400 font-bold">Management Hub</span>
            </div>
        </div>

        <!-- Módulos de Enlaces Modernos -->
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Principal</div>
            
            <a href="/admin" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <span>Estadísticas Finanzas</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
            </a>

            <div class="pt-4 px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Gestión de Negocio</div>

            <a href="/admin/citas" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-calendar-days text-sm"></i>
                    </div>
                    <span>Turnos / Citas</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
            </a>

            <a href="/admin/servicios" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-scissors"></i>
                    </div>
                    <span>Servicios</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
            </a>

            <a href="/admin/barberos" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-user-gear text-sm"></i>
                    </div>
                    <span>Barberos</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
            </a>

            <a href="/admin/indumentaria" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-shirt text-sm"></i>
                    </div>
                    <span>Catálogo Indumentaria</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
            </a>

            <a href="/admin/mail" class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-semibold text-slate-200 hover:bg-gradient-to-r hover:from-blue-600/15 hover:to-indigo-600/5 hover:text-blue-400 transition-all group border border-transparent hover:border-blue-500/30 shadow-sm text-decoration-none relative">
    <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-blue-400 group-hover:border-blue-500/40 transition-all shadow-inner">
            <i class="fa-solid fa-envelope text-sm"></i>
        </div>
        <div class="relative flex items-center">
            <span>Gestión de Mail</span>
            <!-- ID obligatorio para que el JS pueda actualizar y reducir el número -->
            <span id="badgeMailCount" class="hidden ml-2 px-1.5 py-0.5 text-[10px] font-bold bg-rose-500 text-white rounded-full shadow-lg animate-pulse">0</span>
        </div>
    </div>
    <i class="fa-solid fa-chevron-right text-[10px] text-slate-600 group-hover:text-blue-400 transition-transform group-hover:translate-x-0.5"></i>
</a>
        </nav>
   
    </aside>

    <!-- 2. CONTENEDOR DERECHO (Navbar superior, Contenido y Footer) -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        
        <!-- BARRA SUPERIOR / NAVBAR HORIZONTAL RESPONSIVA -->
        <header class="w-full bg-[#0D111A]/90 backdrop-blur-xl border-b border-[#1E2638] sticky top-0 z-40 px-4 sm:px-6 py-3.5 flex items-center justify-between shadow-lg">
            <div class="flex items-center gap-3">
                <a href="/admin" class="flex items-center gap-2.5 group md:hidden text-decoration-none">
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center p-1">
                        <img src="/img/buho.png" alt="Logo Búho" class="w-full h-full object-contain">
                    </div>
                </a>
                <span class="text-sm sm:text-base font-semibold text-slate-300">Panel de Control</span>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center gap-2 sm:gap-3">
                <a href="/" target="_blank" class="btn-reflejo px-3 sm:px-4 py-2 bg-[#0D111A] hover:bg-[#1E2638] border border-blue-500/40 hover:border-blue-400 hover:shadow-[0_0_15px_rgba(59,130,246,0.3)] rounded-xl text-xs font-semibold text-slate-200 transition-all flex items-center gap-1.5 sm:gap-2 shadow-sm text-decoration-none">
                    <i class="fa-solid fa-globe text-blue-400"></i>
                    <span class="hidden xs:inline sm:inline">Ver Portal</span>
                </a>
                
                <a href="/logout" class="btn-reflejo px-3 sm:px-4 py-2 bg-red-500/10 hover:bg-red-500/25 border border-red-500/40 hover:border-red-500 hover:shadow-[0_0_15px_rgba(239,68,68,0.3)] rounded-xl text-xs font-semibold text-red-400 transition-all flex items-center gap-1.5 sm:gap-2 shadow-sm text-decoration-none">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="hidden xs:inline sm:inline">Cerrar Sesión</span>
                </a>
            </div>
        </header>

        <!-- CONTENEDOR PRINCIPAL / VISTAS -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-[1400px] w-full mx-auto">
            <%- body %>
        </main>

        <!-- FOOTER -->
        <footer class="w-full bg-slate-900/40 border-t border-white/5 py-4 px-6 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-center gap-3">
            <p>Barbería Búho &copy; <%= new Date().getFullYear() %> — Todos los derechos reservados.</p>
        </footer>
    </div>
</body>
</html>