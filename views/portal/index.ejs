<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BÚHO Barber Studio - Inicio</title>
    
    <!-- Estilos CSS Base -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }
        
        /* FONDO GENERAL DE TODA LA PÁGINA (Cambiado a un tono claro elegante, tipo gris perlado/blanco suave) */
        body { 
            background-color: #f8fafc; 
            color: #0f172a; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            overflow-x: hidden; 
        }

        /* Efecto de destello/reflejo */
        .btn-reflejo {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .btn-reflejo::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to right,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.2) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            transform: rotate(30deg) translateX(-100%);
            transition: transform 0.6s ease-in-out;
        }
        .btn-reflejo:hover::after {
            transform: rotate(30deg) translateX(100%);
        }
    </style>
</head>
<body class="antialiased selection:bg-pink-500 selection:text-white">

    <!-- SECCIÓN PRINCIPAL / HERO CON IMAGEN DE ALTA DEFINICIÓN -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-slate-900">
        <!-- Imagen de fondo nítida, sin bruma excesiva, con contraste elevado -->
        <div class="absolute inset-0 z-0">
            <img src="/img/hero-barberia.jpg" alt="BÚHO Barber Studio" class="w-full h-full object-cover opacity-65 contrast-125 saturate-110">
            <!-- Degradado sutil solo en los extremos superior e inferior para fundirse -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/70"></div>
        </div>

        <!-- Contenido del Hero con sombras profundas para destacar sobre la imagen -->
        <div class="relative z-10 container mx-auto px-6 py-24 text-center">
            <span class="inline-block py-1.5 px-4 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-semibold uppercase tracking-widest mb-6 backdrop-blur-md shadow-lg">
                Estética & Cuidado Masculino
            </span>
            <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight drop-shadow-[0_10px_15px_rgba(0,0,0,0.9)]">
                BÚHO <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-pink-500">Barber Studio</span>
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-slate-200 max-w-2xl mx-auto font-medium drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)] leading-relaxed">
                El punto de encuentro entre la vanguardia, la elegancia clásica y el estilo moderno.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <a href="/reservar" class="btn-reflejo px-8 py-4 bg-gradient-to-r from-blue-600 to-pink-600 hover:from-blue-500 hover:to-pink-500 text-white font-bold rounded-xl shadow-[0_4px_20px_rgba(236,72,153,0.4)] transition-all flex items-center gap-3 text-base">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Reservar Mi Turno</span>
                </a>
                <a href="#servicios" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl border border-white/20 backdrop-blur-md transition-all text-base">
                    Ver Servicios
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE SERVICIOS / CONTENIDO GENERAL -->
    <main class="flex-grow container mx-auto px-6 py-16 space-y-20">
        <div id="servicios" class="text-center space-y-4">
            <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Nuestros Servicios</h2>
            <p class="text-slate-600 max-w-xl mx-auto text-sm">Descubre la variedad de cortes, perfilados y tratamientos diseñados exclusivamente para vos.</p>
        </div>
        <!-- Aquí se renderiza el resto del contenido dinámico de tu index -->
    </main>

    <!-- FOOTER -->
    <footer class="w-full bg-slate-900 text-white py-10 px-6 mt-auto flex flex-col items-center justify-center text-center gap-5">
        <div class="text-lg font-extrabold tracking-wider">
            BÚHO <span class="text-pink-500">STUDIO</span>
        </div>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
            El punto de encuentro entre la estética moderna y el cuidado masculino profesional.
        </p>
        <div class="border-t border-slate-800 pt-4 w-full max-w-xs text-xs text-slate-500 font-medium">
            &copy; 2026 BÚHO Barber Studio. Todos los derechos reservados.
        </div>
    </footer>

</body>
</html>