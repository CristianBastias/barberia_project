<!-- SECCIÓN CATÁLOGO DE INDUMENTARIA & MERCH (Dinámico desde Base de Datos) -->
<section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold text-pink-500 uppercase tracking-widest block mb-2">Streetwear & Estilo</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
            Catálogo de <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-pink-500">Indumentaria</span>
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">Lleva la cultura de Búho Barber Studio a tu día a día con nuestra merch exclusiva.</p>
    </div>

    <!-- Contenedor que se llenará dinámicamente -->
    <div id="catalogoIndumentariaGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Cargando inicial -->
        <div class="col-span-full text-center py-10 text-slate-500 italic">
            Cargando catálogo de indumentaria...
        </div>
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    cargarCatalogoPublico();
});

async function cargarCatalogoPublico() {
    try {
        const response = await fetch('/api/indumentaria');
        if (!response.ok) throw new Error('Error al obtener la indumentaria');
        const productos = await response.json();
        
        renderizarCatalogoPublico(productos);
    } catch (error) {
        console.error("Error:", error);
    }
}

function renderizarCatalogoPublico(productos) {
    const grid = document.getElementById('catalogoIndumentariaGrid');
    if (!grid) return;

    grid.innerHTML = '';

    // Filtramos solo los productos que estén activos (activo == 1)
    const activos = productos.filter(p => p.activo == 1 || p.activo === true);

    if (activos.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-500 italic bg-slate-900/40 rounded-2xl border border-slate-800/80">No hay prendas disponibles en este momento.</div>`;
        return;
    }

    activos.forEach(item => {
        const card = document.createElement('div');
        card.className = "bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl flex flex-col justify-between group hover:border-blue-500/50 transition-all";

        const imagenSrc = item.imagen_url ? item.imagen_url : '/img/ropa.jpg';
        const precioFormateado = parseFloat(item.precio).toLocaleString('es-AR', { minimumFractionDigits: 2 });
        
        // Control visual de stock en la etiqueta superior
        let badgeStock = '';
        if (item.stock > 0 && item.stock <= 3) {
            badgeStock = `<span class="absolute top-4 right-4 px-3 py-1 bg-amber-600/90 backdrop-blur-md text-white text-xs font-bold rounded-full shadow-lg">¡Últimos en stock!</span>`;
        } else if (item.stock == 0) {
            badgeStock = `<span class="absolute top-4 right-4 px-3 py-1 bg-rose-600/90 backdrop-blur-md text-white text-xs font-bold rounded-full shadow-lg">Agotado</span>`;
        } else {
            badgeStock = `<span class="absolute top-4 right-4 px-3 py-1 bg-blue-600/90 backdrop-blur-md text-white text-xs font-bold rounded-full shadow-lg">Disponible</span>`;
        }

        const mensajeWpp = encodeURIComponent(`Hola! Quiero consultar por la prenda: ${item.nombre}`);

        card.innerHTML = `
            <div class="relative h-72 overflow-hidden bg-slate-950">
                <img src="${imagenSrc}" alt="${item.nombre}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                ${badgeStock}
            </div>
            <div class="p-6 flex flex-col gap-4 flex-grow justify-between">
                <div>
                    <h3 class="text-xl font-bold text-white mb-1">${item.nombre}</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">${item.descripcion || 'Sin descripción detallada.'}</p>
                </div>
                <div class="flex items-center justify-between pt-4 border-t border-slate-800/80">
                    <span class="text-xl font-extrabold text-pink-500">$${precioFormateado}</span>
                    <a href="https://wa.me/?text=${mensajeWpp}" target="_blank" class="px-4 py-2 bg-slate-800 hover:bg-blue-600 text-white text-xs font-bold rounded-xl transition-colors flex items-center gap-2">
                        <i class="fa-brands fa-whatsapp"></i> Consultar
                    </a>
                </div>
            </div>
        `;
        grid.appendChild(card);
    });
}
</script>