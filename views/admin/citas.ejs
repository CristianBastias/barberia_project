<div class="p-6 space-y-6 max-w-[100%] overflow-hidden">
    <div class="flex items-center gap-4 mb-8">
        <div class="p-3 bg-gradient-to-br from-emerald-500/20 to-emerald-300/10 border border-emerald-500/30 rounded-2xl shadow-[0_0_15px_rgba(52,211,153,0.2)] text-emerald-400">
          <i class="fa-solid fa-calendar-days text-xl"></i>
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Gestión de Turnos</h1>
           <p class="text-slate-400 text-sm mt-1">Control integral de citas agendadas y disponibilidad de clientes.</p>
        </div>
    </div>
    <!-- Barra de Controles y Filtros Globales Unificada -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <!-- 1. Controles de Vista -->
            <div class="inline-flex rounded-xl p-1 bg-slate-950 border border-slate-800 w-full sm:w-auto">
                <button type="button" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-white bg-blue-600 shadow-md" id="btn-lista" onclick="cambiarVista('lista')">
                    <i class="fa-solid fa-list-ul mr-1.5"></i> Lista
                </button>
                <button type="button" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white" id="btn-calendario" onclick="cambiarVista('calendario')">
                    <i class="fa-solid fa-calendar-days mr-1.5"></i> Calendario
                </button>
            </div>

            <!-- 2. Botones de Acción Rápida -->
            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <button class="bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-2 rounded-xl text-sm transition-all" onclick="cargarTurnosDesdeBD()" title="Actualizar datos">
                    <i class="fa-solid fa-rotate"></i>
                </button>
                <button onclick="prepararNuevoTurno()" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2 rounded-xl text-sm transition-all shadow-lg shadow-blue-600/20 flex items-center gap-2">
                    <i class="fa-solid fa-plus text-xs"></i>
                    Nuevo Turno
                </button>
            </div>
        </div>

        <!-- Filtros Globales Integrados -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 pt-2 border-t border-slate-800">
            <div>
                <select class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="filtro-estado" onchange="aplicarFiltrosGlobales()">
                    <option value="todos" selected>Todos los estados</option>
                    <option value="confirmado">Confirmados / Completados</option>
                    <option value="pendiente">Pendientes</option>
                    <option value="cancelado">Cancelados</option>
                </select>
            </div>
            <div>
                <select class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="filtro-servicio" onchange="aplicarFiltrosGlobales()">
                    <option value="todos" selected>Todos los servicios</option>
                </select>
            </div>
            <div>
                <input type="text" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="filtro-cliente" placeholder="Buscar por cliente..." oninput="aplicarFiltrosGlobales()">
            </div>
            <div>
                <input type="text" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="filtro-telefono" placeholder="Buscar por teléfono..." oninput="aplicarFiltrosGlobales()">
            </div>
            <div>
                <button type="button" class="w-full bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 font-medium py-2.5 rounded-xl text-sm transition-all flex items-center justify-center gap-1.5" onclick="limpiarFiltros()">
                    <i class="fa-solid fa-rotate-right text-xs"></i> Limpiar Filtros
                </button>
            </div>
        </div>
    </div>

    <!-- Resumen estadístico dinámico y actualizado -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="stats-summary">
        <div class="bg-slate-900 border border-slate-800 border-l-4 border-l-blue-500 rounded-2xl p-5 shadow-xl">
            <div class="text-2xl font-bold text-blue-400" id="stats-total">0</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Total Turnos</div>
        </div>
        <div class="bg-slate-900 border border-slate-800 border-l-4 border-l-emerald-500 rounded-2xl p-5 shadow-xl">
            <div class="text-2xl font-bold text-emerald-400" id="stats-confirmados">0</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Confirmados</div>
        </div>
        <div class="bg-slate-900 border border-slate-800 border-l-4 border-l-amber-500 rounded-2xl p-5 shadow-xl">
            <div class="text-2xl font-bold text-amber-400" id="stats-pendientes">0</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Pendientes</div>
        </div>
        <div class="bg-slate-900 border border-slate-800 border-l-4 border-l-rose-500 rounded-2xl p-5 shadow-xl">
            <div class="text-2xl font-bold text-rose-400" id="stats-cancelados">0</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Cancelados</div>
        </div>
    </div>

    <!-- Vista Lista / Tabla de Turnos -->
<div id="vista-lista" class="space-y-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center">
            <h5 class="font-bold text-slate-200 text-base">Historial de Turnos</h5>
            <span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-3 py-1 rounded-full text-xs font-medium" id="total-turnos">0 turnos</span>
        </div>

        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-950/60 border-b border-slate-800 text-xs font-semibold text-blue-400 uppercase tracking-wider">
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Nombre</th>
                        <th class="py-4 px-6">Fecha</th>
                        <th class="py-4 px-6">Hora</th>
                        <th class="py-4 px-6">Teléfono</th>
                        <th class="py-4 px-6">Servicio</th>
                        <th class="py-4 px-6">Barbero</th>
                        <th class="py-4 px-6">Estado</th>
                        <th class="py-4 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-turnos" class="divide-y divide-slate-800 text-sm text-slate-300">
                    <% if (typeof turnos !== 'undefined' && turnos.length > 0) { %>
                        <% turnos.forEach(turno => { %>
                            <tr class="hover:bg-slate-950/40 transition-colors">
                                <!-- 1. ID -->
                                <td class="py-4 px-6 font-mono text-xs text-slate-400">#<%= turno.id %></td>
                                
                                <!-- 2. Nombre (Leyendo cliente_nombre asegurando que no falle) -->
                                <td class="py-4 px-6 font-semibold text-white">
                                    <%= turno.cliente_nombre || turno.nombre || 'Cliente General' %>
                                </td>
                                
                                <!-- 3. Fecha -->
                                <td class="py-4 px-6 text-slate-300">
                                    <%= turno.fecha_hora ? (typeof turno.fecha_hora === 'string' ? turno.fecha_hora.split('T')[0] : turno.fecha_hora.toISOString().split('T')[0]) : '' %>
                                </td>
                                
                                <!-- 4. Hora -->
                                <td class="py-4 px-6 font-medium text-slate-200">
                                    <%= turno.fecha_hora ? (typeof turno.fecha_hora === 'string' && turno.fecha_hora.includes('T') ? turno.fecha_hora.split('T')[1].substring(0,5) : turno.fecha_hora.toTimeString?.().substring(0,5) || '') : '' %>
                                </td>
                                
                                <!-- 5. Teléfono -->
                                <td class="py-4 px-6 text-slate-300"><%= turno.telefono || 'Sin teléfono' %></td>
                                
                                <!-- 6. Servicio -->
                                <td class="py-4 px-6 text-slate-300"><%= turno.servicio_nombre || 'Servicio #' + turno.servicio_id %></td>
                                
                                <!-- 7. Barbero -->
                                <td class="py-4 px-6 text-slate-300"><%= turno.barbero_nombre || 'Barbero #' + turno.barbero_id %></td>
                                
                                <!-- 8. Estado -->
                                <td class="py-4 px-6">
                                    <% if (turno.estado === 'confirmado' || turno.estado === 'confirmada') { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            Confirmado
                                        </span>
                                    <% } else if (turno.estado === 'pendiente') { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            Pendiente
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20">
                                            Cancelado
                                        </span>
                                    <% } %>
                                </td>
                                
                                <!-- 9. Acciones -->
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button onclick="abrirModalEditar('<%= turno.id %>')" class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 hover:bg-blue-600 hover:text-white transition-all shadow-sm" title="Editar turno">
                                            <i class="fa-solid fa-pen-to-square text-xs"></i>
                                        </button>
                                        <button onclick="eliminarTurno('<%= turno.id %>')" class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 hover:bg-rose-600 hover:text-white transition-all shadow-sm" title="Eliminar turno">
                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="py-8 text-center text-slate-500">
                                No hay turnos registrados actualmente.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

    <!-- Vista Calendario (Oculta por defecto) -->
    <div id="vista-calendario" class="hidden space-y-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl p-6 text-slate-300">
            <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
                <h5 class="font-bold text-slate-200 text-base flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-blue-400"></i> Agenda Interactiva de Turnos
                </h5>
                <span class="text-xs text-slate-400">Vista de Tarjetas por Fecha</span>
            </div>
            <!-- Contenedor dinámico de tarjetas de calendario -->
            <div id="contenedor-calendario"></div>
        </div>
    </div>
</div>

<!-- Modal para Crear / Editar Turno -->
<div id="modalEditarTurno" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-slate-900 border border-blue-500/40 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden my-8">
        <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
            <h5 class="text-blue-400 font-bold text-base flex items-center gap-2" id="modalTitulo">
                <i class="fa-solid fa-pen-to-square"></i> Gestión de Turno
            </h5>
            <button type="button" class="text-slate-400 hover:text-white text-xl" onclick="toggleModal('modalEditarTurno')">&times;</button>
        </div>
        
        <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
            <form id="formEditarTurno" class="space-y-4">
                <input type="hidden" id="editarTurnoId" value="">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="editarFecha" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-calendar-days text-blue-400 mr-1"></i>Fecha *</label>
                        <input type="date" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarFecha" required>
                    </div>
                    <div>
                        <label for="editarHora" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-clock text-blue-400 mr-1"></i>Hora *</label>
                        <input type="time" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarHora" required>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="editarNombre" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-user text-blue-400 mr-1"></i>Nombre y Apellido *</label>
                        <input type="text" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarNombre" required placeholder="Ej: Maximiliano Barrera">
                    </div>
                    <div>
                        <label for="editarTelefono" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-phone text-blue-400 mr-1"></i>Teléfono *</label>
                        <input type="tel" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarTelefono" required placeholder="3804555555">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="editarBarberoId" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-user-gear text-blue-400 mr-1"></i>Barbero ID *</label>
                        <input type="number" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarBarberoId" required placeholder="Ej: 2">
                    </div>
                    <div>
                        <label for="editarServicioId" class="block text-xs font-medium text-slate-300 mb-1"><i class="fa-solid fa-scissors text-blue-400 mr-1"></i>Servicio ID *</label>
                        <input type="number" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-3 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500" id="editarServicioId" required placeholder="Ej: 3">
                    </div>
                </div>
            </form>
        </div>

        <div class="px-6 py-4 border-t border-slate-800 flex justify-end gap-3">
            <button type="button" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium px-4 py-2.5 rounded-xl text-sm transition-all" onclick="toggleModal('modalEditarTurno')">
                <i class="fa-solid fa-xmark mr-1"></i>Cancelar
            </button>
            <button type="button" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-blue-600/20" onclick="guardarEdicionTurno()" id="btnGuardar">
                <i class="fa-solid fa-check mr-1"></i>Guardar Cambios
            </button>
        </div>
    </div>
</div>

<script>
    // Función para alternar la visibilidad del modal de forma segura
    function toggleModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.toggle('hidden');
        }
    }

    // Función que procesa el guardado o actualización de la cita desde el panel
    async function guardarEdicionTurno() {
        const id = document.getElementById('editarTurnoId').value;
        const fechaInput = document.getElementById('editarFecha').value;
        const horaInput = document.getElementById('editarHora').value;
        
        if (!fechaInput || !horaInput) {
            alert('Por favor complete la fecha y la hora.');
            return;
        }

        const fecha_hora = `${fechaInput} ${horaInput}:00`;

        const payload = {
            nombre: document.getElementById('editarNombre').value,
            telefono: document.getElementById('editarTelefono').value,
            barbero_id: document.getElementById('editarBarberoId').value,
            servicio_id: document.getElementById('editarServicioId').value,
            fecha_hora: fecha_hora
        };

        try {
            // Si hay un ID existente, se actualiza; de lo contrario, se crea
            const url = id ? `/citas/${id}` : '/citas';
            const method = id ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (response.ok) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: result.mensaje || 'Operación realizada correctamente.',
                        confirmButtonColor: '#2563eb',
                        background: '#0D111A',
                        color: '#f3f4f6'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    alert('Operación realizada correctamente.');
                    location.reload();
                }
            } else {
                throw new Error(result.error || 'No se pudo guardar la información.');
            }
        } catch (error) {
            console.error('Error al guardar turno:', error);
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: error.message,
                    confirmButtonColor: '#2563eb',
                    background: '#0D111A',
                    color: '#f3f4f6'
                });
            } else {
                alert('Error: ' + error.message);
            }
        }
    }
</script>


<!-- LOGICA DE SCRIPTS UNIFICADA -->
<script>
    let todosLosTurnos = [];

    document.addEventListener("DOMContentLoaded", function () {
        cargarTurnosDesdeBD();
    });

    function toggleModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.toggle('hidden');
        }
    }

    function prepararNuevoTurno() {
        const idInput = document.getElementById('editarTurnoId');
        if(idInput) idInput.value = '';
        
        document.getElementById('editarFecha').value = '';
        document.getElementById('editarHora').value = '';
        document.getElementById('editarNombre').value = '';
        document.getElementById('editarTelefono').value = '';
        document.getElementById('editarBarberoId').value = '';
        document.getElementById('editarServicioId').value = '';

        const titulo = document.getElementById('modalTitulo');
        if(titulo) titulo.innerHTML = `<i class="fa-solid fa-plus"></i> Registrar Nuevo Turno`;

        toggleModal('modalEditarTurno');
    }

    function obtenerEstiloEstado(estado) {
        const est = estado ? estado.toLowerCase() : '';
        switch (est) {
            case 'completado':
            case 'confirmado':
                return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
            case 'cancelado':
                return 'bg-rose-500/10 text-rose-400 border-rose-500/20';
            case 'pendiente':
            default:
                return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
        }
    }

    async function cargarTurnosDesdeBD() {
        try {
            const response = await fetch('/citas');
            todosLosTurnos = await response.json(); 
            aplicarFiltrosGlobales(); // Actualiza estadísticas, tabla y calendario según datos globales y filtros
        } catch (error) {
            console.error("Error al cargar los turnos:", error);
        }
    }

    function actualizarEstadisticas(citas) {
        let total = citas.length;
        let confirmados = 0;
        let pendientes = 0;
        let cancelados = 0;

        citas.forEach(cita => {
            const est = (cita.estado || 'pendiente').toLowerCase();
            if (est === 'confirmado' || est === 'completado') {
                confirmados++;
            } else if (est === 'cancelado') {
                cancelados++;
            } else {
                pendientes++;
            }
        });

        document.getElementById('stats-total').innerText = total;
        document.getElementById('stats-confirmados').innerText = confirmados;
        document.getElementById('stats-pendientes').innerText = pendientes;
        document.getElementById('stats-cancelados').innerText = cancelados;
    }

    function renderizarTabla(citas) {
        const tbody = document.getElementById('tabla-turnos');
        if (!tbody) return;
        
        tbody.innerHTML = ''; 

        if (!citas || citas.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-6 text-slate-500">No hay turnos registrados que coincidan con la búsqueda.</td></tr>`;
            const totalElem = document.getElementById('total-turnos');
            if(totalElem) totalElem.innerText = `0 turnos`;
            return;
        }

        citas.forEach(cita => {
            const tr = document.createElement('tr');
            tr.className = "border-b border-slate-800 text-sm text-slate-300 hover:bg-slate-950/40 transition-all";
            
            const clasesEstado = obtenerEstiloEstado(cita.estado);
            
            const clienteNombre = cita.cliente || cita.cliente_nombre || cita.nombre_cliente || 'Cliente General';
            const telefonoVal = cita.telefono || cita.celular || '';
            const servicioVal = cita.servicio_nombre || cita.servicio || '';
            const barberoVal = cita.barbero_nombre || cita.barbero || '';
            const estadoActual = (cita.estado || 'pendiente').toLowerCase();

            let fechaStr = '';
            let horaStr = '';

            if (cita.fecha_hora) {
                const fechaObj = new Date(cita.fecha_hora);
                if (!isNaN(fechaObj.getTime())) {
                    fechaStr = fechaObj.toISOString().split('T')[0];
                    horaStr = fechaObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                } else {
                    const partes = cita.fecha_hora.split('T');
                    fechaStr = partes[0] || '';
                    horaStr = partes[1] ? partes[1].substring(0, 5) : '';
                }
            } else {
                fechaStr = cita.fecha || '';
                horaStr = cita.hora || '';
            }

            let botonesAccion = '';

            if (estadoActual === 'completado' || estadoActual === 'confirmado') {
                botonesAccion = `
                    <span class="text-emerald-500 text-xs italic mr-1">Finalizado</span>
                    <button type="button" onclick="eliminarTurno(${cita.id})" class="text-rose-400 hover:text-rose-300 p-1" title="Eliminar">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
            } else if (estadoActual === 'cancelado') {
                botonesAccion = `
                    <span class="text-rose-500 text-xs italic mr-1">Cancelado</span>
                    <button type="button" onclick="eliminarTurno(${cita.id})" class="text-rose-400 hover:text-rose-300 p-1" title="Eliminar">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
            } else {
                botonesAccion = `
                    <button type="button" onclick="cambiarEstadoCita(${cita.id}, 'completado')" class="text-emerald-400 hover:text-emerald-300 p-1" title="Marcar como Completado">
                        <i class="fa-solid fa-check"></i>
                    </button>
                    <button type="button" onclick="cambiarEstadoCita(${cita.id}, 'cancelado')" class="text-amber-400 hover:text-amber-300 p-1" title="Cancelar Turno">
                        <i class="fa-solid fa-ban"></i>
                    </button>
                    <button type="button" onclick="eliminarTurno(${cita.id})" class="text-rose-400 hover:text-rose-300 p-1" title="Eliminar">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
            }

            // ORDEN ESTRICTO CORREGIDO: ID, Nombre, Fecha, Hora, Teléfono, Servicio, Barbero, Estado, Acciones
            tr.innerHTML = `
                <td class="py-4 px-6 font-mono text-xs text-slate-400">#${cita.id}</td>
                <td class="py-4 px-6 font-medium text-slate-200">${clienteNombre}</td>
                <td class="py-4 px-6">${fechaStr}</td>
                <td class="py-4 px-6">${horaStr}</td>
                <td class="py-4 px-6">${telefonoVal}</td>
                <td class="py-4 px-6">${servicioVal}</td>
                <td class="py-4 px-6">${barberoVal}</td>
                <td class="py-4 px-6">
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium border ${clasesEstado}">
                        ${cita.estado || 'Pendiente'}
                    </span>
                </td>
                <td class="py-4 px-6 text-right whitespace-nowrap space-x-2">
                    ${botonesAccion}
                </td>
            `;
            tbody.appendChild(tr);
        });

        const totalElem = document.getElementById('total-turnos');
        if(totalElem) totalElem.innerText = `${citas.length} turnos`;
    }

    function renderizarCalendario(citas) {
        const contenedor = document.getElementById('contenedor-calendario');
        if (!contenedor) return;

        contenedor.innerHTML = '';

        if (!citas || citas.length === 0) {
            contenedor.innerHTML = `<p class="text-slate-500 py-4 text-center">No hay turnos para mostrar en el calendario con los filtros actuales.</p>`;
            return;
        }

        let html = '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-left">';
        
        citas.forEach(cita => {
            const cliente = cita.cliente || cita.cliente_nombre || cita.nombre || 'Cliente General';
            const fechaStr = cita.fecha_hora ? cita.fecha_hora.split('T')[0] : (cita.fecha || '');
            const horaStr = cita.fecha_hora ? cita.fecha_hora.split('T')[1]?.substring(0, 5) : (cita.hora || '');
            const estado = cita.estado || 'Pendiente';
            
            html += `
                <div class="bg-slate-950 border border-slate-800 p-4 rounded-xl shadow-md space-y-2">
                    <div class="flex justify-between items-center text-xs text-blue-400 font-semibold">
                        <span><i class="fa-solid fa-calendar mr-1"></i>${fechaStr}</span>
                        <span><i class="fa-solid fa-clock mr-1"></i>${horaStr}</span>
                    </div>
                    <div class="font-bold text-slate-200 text-sm">${cliente}</div>
                    <div class="text-xs text-slate-400">Tel: ${cita.telefono || 'Sin número'}</div>
                    <div class="pt-2 flex justify-between items-center border-t border-slate-800 text-xs">
                        <span class="px-2 py-0.5 rounded-full border ${obtenerEstiloEstado(estado)}">${estado}</span>
                    </div>
                </div>
            `;
        });

        html += '</div>';
        contenedor.innerHTML = html;
    }

    function aplicarFiltrosGlobales() {
        const estadoFiltro = document.getElementById('filtro-estado').value.toLowerCase();
        const textoCliente = document.getElementById('filtro-cliente').value.toLowerCase().trim();
        const textoTelefono = document.getElementById('filtro-telefono').value.toLowerCase().trim();

        const resultadosFiltrados = todosLosTurnos.filter(cita => {
            const cliente = (cita.cliente || cita.cliente_nombre || cita.nombre_cliente || '').toLowerCase();
            const telefono = (cita.telefono || cita.celular || '').toLowerCase();
            const estadoCita = (cita.estado || 'pendiente').toLowerCase();

            const cumpleEstado = (estadoFiltro === 'todos') || (estadoCita.includes(estadoFiltro));
            const cumpleCliente = cliente.includes(textoCliente);
            const cumpleTelefono = telefono.includes(textoTelefono);

            return cumpleEstado && cumpleCliente && cumpleTelefono;
        });

        actualizarEstadisticas(todosLosTurnos); // Mantiene las tarjetas con el total general o se puede pasar resultadosFiltrados si prefieres métricas filtradas
        renderizarTabla(resultadosFiltrados);
        renderizarCalendario(resultadosFiltrados);
    }

    function limpiarFiltros() {
        document.getElementById('filtro-estado').value = 'todos';
        document.getElementById('filtro-cliente').value = '';
        document.getElementById('filtro-telefono').value = '';
        
        aplicarFiltrosGlobales();
    }

    function cambiarVista(tipo) {
        const vistaLista = document.getElementById('vista-lista');
        const vistaCalendario = document.getElementById('vista-calendario');
        const btnLista = document.getElementById('btn-lista');
        const btnCalendario = document.getElementById('btn-calendario');

        if (tipo === 'lista') {
            vistaLista.classList.remove('hidden');
            vistaCalendario.classList.add('hidden');
            
            btnLista.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-white bg-blue-600 shadow-md";
            btnCalendario.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white";
        } else {
            vistaLista.classList.add('hidden');
            vistaCalendario.classList.remove('hidden');
            
            btnCalendario.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-white bg-blue-600 shadow-md";
            btnLista.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white";
            
            aplicarFiltrosGlobales();
        }
    }

    async function guardarEdicionTurno() {
    const id = document.getElementById('editarTurnoId').value;
    const fechaInput = document.getElementById('editarFecha').value;
    const horaInput = document.getElementById('editarHora').value;
    
    if (!fechaInput || !horaInput) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'warning',
                title: 'Campos incompletos',
                text: 'Por favor complete la fecha y la hora.',
                confirmButtonColor: '#2563eb',
                background: '#0D111A',
                color: '#f3f4f6'
            });
        } else {
            alert('Por favor complete la fecha y la hora.');
        }
        return;
    }

    const fecha_hora = `${fechaInput} ${horaInput}:00`;

    // CORREGIDO: Se asegura de capturar el nombre real ingresado en el input del modal
    const payload = {
        nombre: document.getElementById('editarNombre').value || 'Cliente General',
        telefono: document.getElementById('editarTelefono').value || '',
        barbero_id: document.getElementById('editarBarberoId').value,
        servicio_id: document.getElementById('editarServicioId').value,
        fecha_hora: fecha_hora,
        metodo_pago: 'efectivo'
    };

    try {
        const url = id ? `/citas/${id}` : '/citas';
        const method = id ? 'PUT' : 'POST';

        const response = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok) {
            // Cierra el modal antes de mostrar la alerta o al confirmar
            if (typeof toggleModal === 'function') {
                toggleModal('modalEditarTurno');
            }

            // ALERTA DE ÉXITO AGREGADA
            if (typeof Swal !== 'undefined') {
                await Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: result.mensaje || 'El turno se guardó correctamente.',
                    confirmButtonColor: '#2563eb',
                    background: '#0D111A',
                    color: '#f3f4f6'
                });
            } else {
                alert('El turno se guardó correctamente.');
            }

            location.reload(); // Recarga para reflejar el nombre real en la tabla
        } else {
            throw new Error(result.error || 'No se pudo guardar la información.');
        }
    } catch (error) {
        console.error('Error al guardar turno:', error);
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'error',
                title: 'Atención',
                text: error.message,
                confirmButtonColor: '#2563eb',
                background: '#0D111A',
                color: '#f3f4f6'
            });
        } else {
            alert('Error: ' + error.message);
        }
    }
}

    async function cambiarEstadoCita(id, nuevoEstado) {
        try {
            const response = await fetch(`/citas/${id}/estado`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: nuevoEstado })
            });

            const resultado = await response.json();

            if (response.ok) {
                cargarTurnosDesdeBD(); 
            } else {
                alert(resultado.error || 'No se pudo actualizar el estado');
            }
        } catch (error) {
            console.error("Error al cambiar el estado:", error);
        }
    }

    async function eliminarTurno(id) {
    if (!confirm('¿Estás seguro de que deseas eliminar este turno?')) return;

    try {
        const response = await fetch(`/citas/${id}`, { method: 'DELETE' });
        
        if (response.ok) {
            // Alerta de éxito añadida
            if (typeof Swal !== 'undefined') {
                await Swal.fire({
                    icon: 'success',
                    title: '¡Eliminado!',
                    text: 'El turno ha sido eliminado correctamente.',
                    confirmButtonColor: '#2563eb',
                    background: '#0D111A',
                    color: '#f3f4f6'
                });
            } else {
                alert('El turno ha sido eliminado correctamente.');
            }

            cargarTurnosDesdeBD(); 
        } else {
            alert('No se pudo eliminar la cita.');
        }
    } catch (error) {
        console.error("Error al eliminar:", error);
    }
}
</script>