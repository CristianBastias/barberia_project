<!-- views/admin/mail.ejs -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4">
      <div class="flex items-center gap-4">
           <!-- Contenedor con degradado verde flúor -->
            <div class="p-3 bg-gradient-to-br from-emerald-500/20 to-emerald-300/10 border border-emerald-500/30 rounded-2xl shadow-[0_0_15px_rgba(52,211,153,0.2)] text-emerald-400">
               <i class="fa-solid fa-envelope-open-text text-xl"></i>
            </div>
            <div>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Gestión de Correo (Mail)</h1>
              <p class="text-slate-400 text-sm mt-1">Envía notificaciones, avisos de citas o revisa la bandeja de correos.</p>
            </div>
        </div>
    </div>

    <div class="space-y-8">
        <!-- 1. Formulario de envío (Ahora arriba ocupando todo el ancho de forma compacta) -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
            <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-paper-plane text-pink-500"></i> Nuevo Correo
            </h2>
            <form id="formMail" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Destinatario (Email) *</label>
                    <!-- CORREGIDO: id cambiado de mailremitente a mailDestinatario para sincronizar con el JS del formulario -->
                    <input type="email" id="mailDestinatario" required placeholder="cliente@correo.com"
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Asunto *</label>
                    <input type="text" id="mailAsunto" required placeholder="Asunto del mensaje..."
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-blue-500">
                </div>
                <div class="md:col-span-3">
                    <label class="block text-xs font-medium text-slate-400 mb-1">Mensaje *</label>
                    <textarea id="mailMensaje" rows="3" required placeholder="Escribe el contenido del correo..."
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-blue-500"></textarea>
                </div>
                <div class="md:col-span-3 flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm rounded-xl transition-all shadow-lg cursor-pointer flex items-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Enviar Correo
                    </button>
                </div>
            </form>
        </div>

        <!-- 2. Bandeja de Entrada / Historial de Mensajes -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-inbox text-blue-400"></i> Bandeja / Historial de Mensajes
                </h3>
                <button onclick="cargarBandejaMail()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-lg transition-colors cursor-pointer">
                    <i class="fa-solid fa-rotate-right mr-1"></i> Actualizar
                </button>
            </div>

            <!-- Tabla con columnas independientes para mayor orden -->
            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-950/80 border-b border-slate-800/80 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            <th class="py-4 px-4">Id</th>
                            <th class="py-4 px-4">Remitente</th>
                            <th class="py-4 px-4">Destinatario</th>
                            <th class="py-4 px-4">Asunto</th>
                            <th class="py-4 px-4">Fecha</th>
                            <th class="py-4 px-4 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaBandejaMail" class="divide-y divide-slate-800/60 text-sm text-slate-300">
                        <tr>
                            <td colspan="5" class="text-center py-8 text-slate-500 italic">Cargando bandeja...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="/js/mail.js"></script>