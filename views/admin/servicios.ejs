<div class="p-6 space-y-6 max-w-[100%] overflow-hidden bg-slate-950 min-h-screen text-slate-100">
    <!-- Encabezado del Módulo -->
    <div class="flex items-center gap-4 mb-8">
        <div class="p-3 bg-gradient-to-br from-emerald-500/20 to-emerald-300/10 border border-emerald-500/30 rounded-2xl shadow-[0_0_15px_rgba(52,211,153,0.2)] text-emerald-400">
          <i class="fa-solid fa-scissors text-xl"></i>
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Catálogo de Servicios</h1>
          <p class="text-slate-400 text-sm mt-1">Configuración de precios, tiempos y oferta del salón.</p>
        </div>
    </div>

   <!-- Formulario para Registrar Nuevo Servicio -->
<div class="bg-slate-900/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-6 shadow-2xl space-y-5">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
        <h3 class="text-sm font-semibold text-blue-400 uppercase tracking-wider flex items-center gap-2">
            <i class="fa-solid fa-circle-plus"></i> Registrar Nuevo Servicio
        </h3>
    </div>
    
    <!-- El <form> envuelve todo el contenido interactivo y el botón -->
    <form id="formNuevoServicio" class="space-y-4" onsubmit="guardarServicio(event)">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div>
                <label for="nuevoNombre" class="block text-xs font-medium text-slate-300 mb-1.5">Nombre del Servicio *</label>
                <input type="text" class="w-full bg-slate-950/80 border border-slate-800 text-slate-100 px-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-slate-600" id="nuevoNombre" required placeholder="Ej: Tratamiento Capilar">
            </div>
            <div>
                <label for="nuevoPrecio" class="block text-xs font-medium text-slate-300 mb-1.5">Precio ($) *</label>
                <input type="number" step="0.01" class="w-full bg-slate-950/80 border border-slate-800 text-slate-100 px-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-slate-600" id="nuevoPrecio" required placeholder="Ej: 5000">
            </div>
            <div>
                <label for="nuevaDuracion" class="block text-xs font-medium text-slate-300 mb-1.5">Duración (días) *</label>
                <input type="number" class="w-full bg-slate-950/80 border border-slate-800 text-slate-100 px-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-slate-600" id="nuevaDuracion" required placeholder="Ej: 3">
            </div>
        </div>

        <!-- Campo selector de imagen -->
        <div class="space-y-2">
           <label for="imagenServicio" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Imagen del Servicio</label>
           <input type="file" id="imagenServicio" name="imagen" accept="image/*"
            class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500 focus:outline-none focus:border-blue-500 transition-all">
        </div>

        <!-- Botón dentro del form que ejecuta la acción de guardar -->
        <div class="flex justify-end gap-3 mt-4">
           <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2.5  rounded-xl text-sm">
            Guardar Servicio
        </button>
    </div>
    </form>
</div>

    <!-- Catálogo Actual (Tabla de Servicios) -->
    <div class="bg-slate-900/80 backdrop-blur-md border border-slate-800/80 rounded-2xl shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800/80 flex justify-between items-center bg-slate-900/40">
            <h3 class="font-bold text-slate-200 text-base flex items-center gap-2">
                <i class="fa-solid fa-list text-slate-400 text-sm"></i> Catálogo Actual
            </h3>
            <span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-3 py-1 rounded-full text-xs font-semibold tracking-wide" id="total-servicios">
                0 servicios
            </span>
        </div>

        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-950/80 border-b border-slate-800/80 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Imagen</th>
                        <th class="py-4 px-6">Nombre</th>
                        <th class="py-4 px-6">Precio</th>
                        <th class="py-4 px-6">Duración</th>
                        <th class="py-4 px-6">Estado</th>
                        <th class="py-4 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-servicios" class="divide-y divide-slate-800/60 text-sm text-slate-300">
                    <tr>
                        <td colspan="7" class="text-center py-8 text-slate-500 italic">Cargando servicios desde la base de datos...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Script de Gestión y Sincronización -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        cargarServiciosDesdeBD();
    });

    async function cargarServiciosDesdeBD() {
        try {
            const response = await fetch('/api/servicios');
            if (!response.ok) throw new Error('Error al conectar con el servidor');
            const servicios = await response.json();
            renderizarTablaServicios(servicios);
        } catch (error) {
            console.error("Error al cargar los servicios:", error);
        }
    }

    function renderizarTablaServicios(servicios) {
        const tbody = document.getElementById('tabla-servicios');
        if (!tbody) return;
        
        tbody.innerHTML = ''; 

        if (!servicios || servicios.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-500 italic">No hay servicios registrados en la base de datos.</td></tr>`;
            document.getElementById('total-servicios').innerText = `0 servicios`;
            return;
        }

        servicios.forEach(serv => {
            const tr = document.createElement('tr');
            tr.className = "border-b border-slate-800/50 text-sm text-slate-300 hover:bg-slate-800/30 transition-all duration-150";
            
            const activo = serv.activo == 1 || serv.activo === true;
            const estadoBadge = activo 
                ? `<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-sm">Activo</span>`
                : `<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20 shadow-sm">Inactivo</span>`;

            const imgHtml = serv.imagen_url 
                ? `<span class="text-xs text-slate-400 font-mono bg-slate-950 px-2 py-1 rounded-md border border-slate-800">${serv.imagen_url}</span>` 
                : `<span class="text-xs text-slate-600 italic">Sin imagen</span>`;

            tr.innerHTML = `
                <td class="py-4 px-6 font-mono text-slate-400 text-xs font-medium">#${serv.id}</td>
                <td class="py-4 px-6">${imgHtml}</td>
                <td class="py-4 px-6 font-medium text-slate-200">${serv.nombre}</td>
                <td class="py-4 px-6 text-emerald-400 font-semibold">$${Number(serv.precio).toLocaleString()}</td>
                <td class="py-4 px-6 text-slate-300">${serv.duracion} dias</td>
                <td class="py-4 px-6">${estadoBadge}</td>
                <td class="py-4 px-6 text-right whitespace-nowrap space-x-2">
                    <button type="button" onclick="verDetalleServicio(${serv.id}, '${serv.nombre}', ${serv.precio}, ${serv.duracion})" class="bg-slate-950 hover:bg-blue-600/20 text-blue-400 border border-slate-800 hover:border-blue-500/30 p-2 rounded-xl transition-all shadow-sm cursor-pointer" title="Ver Detalles">
                        <i class="fa-solid fa-eye text-xs"></i>
                    </button>
                    <button type="button" onclick="prepararEditarServicio(${serv.id}, '${serv.nombre}', ${serv.precio}, ${serv.duracion}, '${serv.imagen_url || ''}')" class="bg-slate-950 hover:bg-amber-600/20 text-amber-400 border border-slate-800 hover:border-amber-500/30 p-2 rounded-xl transition-all shadow-sm cursor-pointer" title="Editar Servicio">
                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                    </button>
                    <button type="button" onclick="eliminarServicio(${serv.id})" class="bg-slate-950 hover:bg-rose-600/20 text-rose-400 border border-slate-800 hover:border-rose-500/30 p-2 rounded-xl transition-all shadow-sm cursor-pointer" title="Eliminar / Desactivar">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('total-servicios').innerText = `${servicios.length} servicios`;
    }

    
    function verDetalleServicio(id, nombre, precio, duracion) {
        alert(`Detalle del Servicio #${id}\n\nNombre: ${nombre}\nPrecio: $${precio}\nDuración: ${duracion} minutos`);
    }

    async function prepararEditarServicio(id, nombre, precio, duracion, imagen) {
    document.getElementById('nuevoNombre').value = nombre;
    document.getElementById('nuevoPrecio').value = precio;
    document.getElementById('nuevaDuracion').value = duracion;
    
    const imagenInput = document.getElementById('nuevaImagen');
    if (imagenInput) {
        imagenInput.value = imagen !== 'null' && imagen ? imagen : '';
    }
    
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Reemplazamos la alerta nativa por SweetAlert con tu diseño personalizado
    if (typeof Swal !== 'undefined') {
        await Swal.fire({
            icon: 'info',
            title: 'Modo Edición Activado',
            text: `Editando el servicio: "${nombre}". Modifica los datos en el formulario y guarda los cambios.`,
            confirmButtonColor: '#2563eb',
            background: '#0D111A',
            color: '#f3f4f6',
            timer: 3000,
            timerProgressBar: true,
            showConfirmButton: true
        });
    } else {
        // Respaldo por si acaso
        alert(`Modo Edición activado para el servicio #${id}. Modifica los datos arriba.`);
    }
   }

    async function eliminarServicio(id) {
        if (!confirm('¿Estás seguro de que deseas desactivar este servicio?')) return;

        try {
            const response = await fetch(`/admin/servicios/${id}`, { method: 'DELETE' });
            
            if (response.ok) {
                alert('Servicio dado de baja con éxito.');
                cargarServiciosDesdeBD(); 
            } else {
                alert('No se pudo eliminar el servicio.');
            }
        } catch (error) {
            console.error("Error al eliminar:", error);
            alert('Error de conexión al intentar eliminar el servicio.');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('formNuevoServicio');
    
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Bloquear el botón para evitar envíos dobles
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerText = 'Guardando...';
            }

            const formData = new FormData();
            formData.append('nombre', document.getElementById('nuevoNombre').value);
            formData.append('precio', document.getElementById('nuevoPrecio').value);
            formData.append('duracion', document.getElementById('nuevaDuracion').value);
            
            const archivoInput = document.getElementById('imagenServicio');
            if (archivoInput && archivoInput.files[0]) {
                formData.append('imagen', archivoInput.files[0]);
            }

            const servicioId = document.getElementById('servicioId')?.value;
            const url = servicioId ? `/admin/servicios/${servicioId}` : '/admin/servicios';
            const method = servicioId ? 'PUT' : 'POST';

            try {
                const response = await fetch(url, {
                    method: method,
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    form.reset();
                    
                    // Verificamos si SweetAlert está disponible. Si no, usamos la alerta nativa.
                    if (typeof Swal !== 'undefined') {
                        await Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: result.message || 'Servicio guardado correctamente.',
                            confirmButtonColor: '#2563eb',
                            background: '#0D111A',
                            color: '#f3f4f6',
                            allowOutsideClick: false
                        });
                    } else {
                        // RESPALDO NATIVO: Si SweetAlert falla, esta alerta siempre aparecerá.
                        alert('¡Éxito! Servicio guardado correctamente.');
                    }
                    
                    // La recarga ocurre independientemente del método de alerta
                    location.reload();

                } else {
                    throw new Error(result.error || 'No se pudo guardar el servicio.');
                }
            } catch (error) {
                console.error('Error durante el guardado:', error);
                
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerText = 'Guardar Servicio';
                }

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Atención',
                        text: error.message,
                        confirmButtonColor: '#2563eb',
                        background: '#0D111A',
                        color: '#f3f4f6'
                    });
                } else {
                    alert('Error: ' + error.message);
                }
            }
        });
    }
});
</script>