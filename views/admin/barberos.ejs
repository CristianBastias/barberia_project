<div class="p-6 space-y-6 max-w-[100%] overflow-hidden bg-slate-950 min-h-screen text-slate-100">
    <div class="flex items-center gap-4 mb-8">
        <div class="p-3 bg-gradient-to-br from-emerald-500/20 to-emerald-300/10 border border-emerald-500/30 rounded-2xl shadow-[0_0_15px_rgba(52,211,153,0.2)] text-emerald-400">
           <i class="fa-solid fa-user-gear text-xl"></i>
        </div>
        <div>
           <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Equipo de Barberos</h1>
           <p class="text-slate-400 text-sm mt-1">Gestión de personal, horarios y métricas de trabajo individual.</p>
        </div>
    </div>

    <!-- Formulario para Registrar / Editar Barbero -->
    <div class="bg-slate-900/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-6 shadow-2xl space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
            <h3 id="formTituloBarbero" class="text-sm font-semibold text-blue-400 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-circle-plus"></i> Registrar Nuevo Barbero
            </h3>
            <button type="button" id="btnCancelarEdicionBarbero" onclick="resetearFormularioBarbero()" class="text-xs text-slate-400 hover:text-white hidden underline cursor-pointer">Cancelar Edición</button>
        </div>
        
        <form id="formCrearBarbero" class="space-y-4">
            <input type="hidden" id="barberoIdEdit">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="nombreBarbero" class="block text-xs font-medium text-slate-300 mb-1.5">Nombre del Barbero *</label>
                    <input type="text" class="w-full bg-slate-950/80 border border-slate-800 text-slate-100 px-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-slate-600" id="nombreBarbero" required placeholder="Ej. Carlos Martínez">
                </div>
                <div>
                    <label for="especialidadBarbero" class="block text-xs font-medium text-slate-300 mb-1.5">Especialidad *</label>
                    <input type="text" class="w-full bg-slate-950/80 border border-slate-800 text-slate-100 px-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-slate-600" id="especialidadBarbero" required placeholder="Ej. Fade & Degradados">
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-4">
                <button type="submit" id="btnSubmitBarbero" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2.5 rounded-xl text-sm transition-all shadow-md cursor-pointer">
                    Guardar Barbero
                </button>
            </div>
        </form>
    </div>

    <!-- Catálogo Actual (Tabla de Barberos) -->
    <div class="bg-slate-900/80 backdrop-blur-md border border-slate-800/80 rounded-2xl shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-800/80 flex justify-between items-center bg-slate-900/40">
            <h3 class="font-bold text-slate-200 text-base flex items-center gap-2">
                <i class="fa-solid fa-list text-slate-400 text-sm"></i> Personal Activo
            </h3>
            <span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-3 py-1 rounded-full text-xs font-semibold tracking-wide" id="contadorBarberos">
                0 barberos
            </span>
        </div>

        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-950/80 border-b border-slate-800/80 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Nombre</th>
                        <th class="py-4 px-6">Especialidad</th>
                        <th class="py-4 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaBarberos" class="divide-y divide-slate-800/60 text-sm text-slate-300">
                    <tr>
                        <td colspan="4" class="text-center py-8 text-slate-500 italic">Cargando barberos desde la base de datos...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="/js/barberos.js"></script>