<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Clientes | Barbería Búho Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass-panel { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex">

    <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between hidden md:flex">
        <div class="p-6">
            <div class="flex items-center space-x-3 mb-10">
                <div class="bg-blue-600 p-2.5 rounded-2xl text-white shadow-lg shadow-blue-500/30">
                    <i class="fas fa-cut text-lg"></i>
                </div>
                <h1 class="font-extrabold tracking-wider text-white text-lg">BÚHO <span class="text-blue-500">ADMIN</span></h1>
            </div>
            <nav class="space-y-2">
                <a href="/admin" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-white transition-all"><i class="fas fa-chart-pie w-5"></i><span class="text-sm font-medium">Dashboard</span></a>
                <a href="/admin/citas" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800/60 hover:text-white transition-all"><i class="fas fa-calendar-alt w-5"></i><span class="text-sm font-medium">Citas / Turnos</span></a>
                <a href="/admin/clientes" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-blue-600/10 text-blue-400 border border-blue-500/20"><i class="fas fa-users w-5"></i><span class="text-sm font-semibold">Clientes</span></a>
            </nav>
        </div>
        <div class="p-6 border-t border-slate-800">
            <a href="/logout" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-red-400 hover:bg-red-500/10 transition-all"><i class="fas fa-sign-out-alt w-5"></i><span class="text-sm font-medium">Cerrar Sesión</span></a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <header class="h-20 bg-slate-900/50 backdrop-blur-md border-b border-slate-800 flex items-center justify-between px-8 sticky top-0 z-10">
            <h2 class="text-xl font-bold text-white tracking-wide">Gestión de Clientes</h2>
            <div class="flex items-center space-x-4">
                <span class="text-xs text-slate-400 bg-slate-800/80 px-3 py-1.5 rounded-full border border-slate-700"><%= user ? user.nombre : 'Admin' %></span>
            </div>
        </header>

        <div class="p-8 space-y-6 max-w-7xl w-full mx-auto">
            <div class="glass-panel p-6 rounded-3xl space-y-4">
                <input type="text" id="buscarCliente" placeholder="Buscar por nombre, email o teléfono..." class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-blue-500">
            </div>

            <div class="glass-panel rounded-3xl overflow-hidden shadow-xl">
                <div class="p-6 border-b border-slate-800/80 flex justify-between items-center">
                    <h3 class="font-bold text-white text-base">Listado de Clientes Registrados</h3>
                    <span id="contadorClientes" class="text-xs text-blue-400 bg-blue-500/10 border border-blue-500/20 px-3 py-1 rounded-full font-mono">0 clientes</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 text-xs uppercase tracking-wider bg-slate-900/40">
                                <th class="py-4 px-6 font-semibold">ID</th>
                                <th class="py-4 px-6 font-semibold">Nombre Completo</th>
                                <th class="py-4 px-6 font-semibold">Correo Electrónico</th>
                                <th class="py-4 px-6 font-semibold">Teléfono</th>
                                <th class="py-4 px-6 font-semibold text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaClientes" class="divide-y divide-slate-800/60 text-sm text-slate-300">
                            <!-- Datos inyectados vía EJS o manejados por JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>